; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but since you are using Termux, direct config works perfectly.

config_version=5

[application]

config/name="FreeFire Bermuda"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.3", "Mobile")

[editor]

import/reimport_missing_imported_files=false
export/convert_text_resources_to_binary=true

[filesystem]

import/fbx/enabled=false
import/blend/enabled=false

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0

[autoload]

Bootstrap="*res://Main.gd"
