; Engine configuration file.
config_version=5

[application]
config/name="Free Fire Clone"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.2", "Mobile")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6
window/vsync/vsync_mode=0

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
scaling_3d/mode=1
scaling_3d/scale=0.60
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/size=128
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
environment/defaults/default_clear_color=Color(0.45, 0.7, 0.98, 1)

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor]
import/fbx/enabled=false
import/blend/enabled=false

[rendering]
textures/vram_compression/import_etc2_astc=true

[editor]
import/reimport_missing_imported_files=false
export/convert_text_resources_to_binary=true

[filesystem]
import/fbx/enabled=false
import/blend/enabled=false
